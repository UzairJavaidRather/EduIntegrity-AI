# =============================================================================
# EduIntegrity AI — Environment Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in the .env file
#   3. NEVER commit your .env file to Git
#   4. This .env.example file is safe to commit — it contains no real secrets
# =============================================================================


# ─── IBM watsonx.ai ──────────────────────────────────────────────────────────
# Your IBM Cloud API key
# Get it from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Your watsonx.ai project ID
# Get it from: https://dataplatform.cloud.ibm.com → your project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai regional endpoint
# Common values: https://us-south.ml.cloud.ibm.com  |  https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID
# Verify the exact model ID from IBM watsonx Prompt Lab before using
# Example format: ibm/granite-13b-instruct-v2  (confirm from IBM documentation)
GRANITE_MODEL_ID=verify_exact_model_id_from_ibm_prompt_lab


# ─── Application ─────────────────────────────────────────────────────────────
# Backend API URL (used by the frontend to make requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Secret key for signing JWT authentication tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_secure_random_string_here

# JWT token expiry in minutes
JWT_EXPIRY_MINUTES=60

# Application environment: development | production
APP_ENV=development

# Backend allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://eduintegrity_user:your_password@localhost:5432/eduintegrity_db


# ─── File Upload ─────────────────────────────────────────────────────────────
# Maximum file size in bytes (default: 10 MB)
MAX_FILE_SIZE_BYTES=10485760

# Directory where uploaded files are temporarily stored (relative to backend/)
UPLOAD_DIR=data/uploads

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf,.docx,.txt


# ─── Semantic Model ──────────────────────────────────────────────────────────
# Sentence Transformer model used for semantic similarity
# Default works offline — no API key needed
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2


# ─── RAG / Vector Database ───────────────────────────────────────────────────
# Path for ChromaDB persistent storage
CHROMA_DB_PATH=rag/chroma_db

# RAG retrieval — number of relevant chunks to retrieve per query
RAG_TOP_K=5


# ─── Risk Score Weights (must sum to 1.0) ────────────────────────────────────
# These are project-defined values — NOT scientifically universal thresholds
# Adjust these to tune the risk model for your institution's needs
WEIGHT_SEMANTIC_SIMILARITY=0.25
WEIGHT_LEXICAL_SIMILARITY=0.20
WEIGHT_STYLE_DEVIATION=0.20
WEIGHT_HISTORICAL_ANOMALY=0.15
WEIGHT_CITATION_ANOMALY=0.10
WEIGHT_AI_INDICATOR=0.10
